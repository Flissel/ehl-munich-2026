# Copy to .env and fill in local values.

# Rowboat / LLM provider key. Paste your real key only in .env.
OPENAI_API_KEY=

# WP3 semantic search settings.
EHL_VAULT=~/.rowboat/knowledge
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ehl_notes
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
