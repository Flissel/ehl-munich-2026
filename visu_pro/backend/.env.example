# Copy to backend/.env and fill in. Never commit backend/.env.

# --- AI (optional: without a key the app still runs; AI requests return a clear error)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60

# --- Unreal viewer
UE_ENGINE_DIR=C:\Program Files\Epic Games\UE_5.8
# UNREAL_PROJECT_PATH=  (defaults to unreal\BMWVisualizer\BMWVisualizer.uproject in this repo)
VIEWER_CONTROL_PORT=30777
# Shared secret between backend and viewer. Leave empty for a random per-run token
# (then the backend must be the one launching the viewer).
VIEWER_TOKEN=
VIEWER_RES_X=1600
VIEWER_RES_Y=900
# First launch compiles shaders; allow a long startup.
VIEWER_STARTUP_TIMEOUT_SECONDS=1800

# --- Web
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Customer feedback dataset (heat map). Default: ..\..\ehl-munich-2026\Dataset next to this project
# FEEDBACK_DATASET_DIR=C:\path\to\ehl-munich-2026\Dataset
